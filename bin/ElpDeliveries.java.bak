import java.sql.Date;
import java.sql.SQLException;

import javafx.application.Application;
import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.control.cell.PropertyValueFactory;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.ColumnConstraints;
import javafx.scene.layout.GridPane;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Pane;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;
import model.Delivery;
import model.GenerateDeliveryList;

public class ElpDeliveries extends Application {
    public static void main(String[] args) {
        launch(args);
    }

    Button searchButton;
    Button addButton;
    Label dateLabel;
    DatePicker searchDatePicker;
    Label fNameLabel;
    TextField fNameTextField;
    Label lNameLabel;
    TextField lNameTextField;
    Label recNumLabel;
    TextField recNumTextField;
    String currentView;
    Label todaysDeliveriesLbl;
    Label uncompletedDeliveriesLbl;
    Label totalDeliveriesLbl;

    public void start(Stage primaryStage) throws Exception {
        primaryStage.setTitle("ELP Deliveries");
        searchButton = new Button("Search");
        addButton = new Button("Add New");

        ObservableList<String> menuItems = FXCollections.observableArrayList(
                "All Deliveries",
                "Deliveries for Today",
                "Future Deliveries",
                "Uncompleted Deliveries",
                "Completed Deliveries");

        BorderPane mainLayout = new BorderPane();

        ListView<String> sidebar = new ListView<>(menuItems);
        sidebar.setPrefWidth(180);

        BorderPane contentArea = new BorderPane();
        contentArea.setPadding(new Insets(10));

        TableView<Delivery> deliveryTable = new TableView<>();
        TableColumn<Delivery, Integer> idCol = new TableColumn<>("#");
        TableColumn<Delivery, String> nameCol = new TableColumn<>("Name");
        TableColumn<Delivery, String> addrCol = new TableColumn<>("Address");
        TableColumn<Delivery, String> phCol = new TableColumn<>("Phone");
        TableColumn<Delivery, Date> dfdCol = new TableColumn<>("Date for Delivery");
        TableColumn<Delivery, Date> comDateCol = new TableColumn<>("Completed Date");
        TableColumn<Delivery, Void> addEditCol = new TableColumn<>("Edit");
        TableColumn<Delivery, Boolean> completedCol = new TableColumn<>("Completed?");
        addEditCol.setCellFactory(col -> new TableCell<Delivery, Void>() {
            private Button btn = new Button("Edit");
            {
                btn.setOnAction(e -> {
                    Delivery selectDelivery = getTableView().getItems().get(getIndex());
                    openAddEdit(primaryStage, selectDelivery, deliveryTable);
                });
            }

            @Override
            protected void updateItem(Void item, boolean empty) {
                super.updateItem(item, empty);
                if (empty) {
                    setGraphic(null);
                } else {
                    btn.prefWidthProperty().bind(getTableColumn().widthProperty().subtract(10));
                    btn.prefHeightProperty().bind(getTableRow().heightProperty().subtract(10));
                    setGraphic(btn);
                }
            }
        });
        deliveryTable.getColumns().addAll(idCol, nameCol, addrCol, phCol, dfdCol, comDateCol, addEditCol, completedCol);
        idCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.05));
        nameCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.12));
        addrCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.25));
        phCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.10));
        dfdCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.12));
        comDateCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.12));
        addEditCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.14));
        completedCol.prefWidthProperty().bind(deliveryTable.widthProperty().multiply(0.10));

        idCol.setCellValueFactory(new PropertyValueFactory<>("id"));
        nameCol.setCellValueFactory(new PropertyValueFactory<>("name"));
        addrCol.setCellValueFactory(new PropertyValueFactory<>("addr"));
        phCol.setCellValueFactory(new PropertyValueFactory<>("phnum"));
        dfdCol.setCellValueFactory(new PropertyValueFactory<>("dlvDate"));
        comDateCol.setCellValueFactory(new PropertyValueFactory<>("completedDate"));
        completedCol.setCellValueFactory(new PropertyValueFactory<>("completed"));

        GenerateDeliveryList dao = new GenerateDeliveryList();
        sidebar.getSelectionModel().selectedItemProperty().addListener((obs, oldVal, newVal) -> {
            currentView = newVal;
            try {
                ObservableList<Delivery> data = FXCollections.observableArrayList(
                        dao.getDeliveries(
                                newVal,
                                null,
                                null,
                                null,
                                null));
                deliveryTable.setItems(data);
            } catch (SQLException e) {
                e.printStackTrace();
                Alert alert = new Alert(Alert.AlertType.ERROR);
                alert.setHeaderText("Database Error");
                alert.setContentText(e.getMessage());
                alert.showAndWait();
            }
        });

        currentView = sidebar.getSelectionModel().getSelectedItem();

        contentArea.setCenter(deliveryTable);
        todaysDeliveriesLbl = new Label();
        uncompletedDeliveriesLbl = new Label();
        totalDeliveriesLbl = new Label();
        refreshStats();
        HBox stats = new HBox(15, todaysDeliveriesLbl, uncompletedDeliveriesLbl, totalDeliveriesLbl);
        HBox bottomBar = new HBox(10, searchButton, addButton, stats);
        bottomBar.setAlignment(Pos.CENTER_LEFT);
        bottomBar.setPadding(new Insets(10, 10, 0, 0));
        searchButton.setOnAction(e -> openSearch(primaryStage, deliveryTable));

        addButton.setOnAction(e -> openAddEdit(primaryStage, null, deliveryTable));

        contentArea.setBottom(bottomBar);

        sidebar.getSelectionModel().selectFirst();

        mainLayout.setLeft(sidebar);
        mainLayout.setCenter(contentArea);

        Scene scene = new Scene(mainLayout, 1280, 720);
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    public void openSearch(Stage primaryStage, TableView<Delivery> deliveryTable) {
        Stage searchStage = new Stage();
        searchStage.initOwner(primaryStage);
        searchStage.setTitle("Search:");
        dateLabel = new Label("Date:");
        searchDatePicker = new DatePicker();
        fNameLabel = new Label("First Name:");
        fNameTextField = new TextField();
        lNameLabel = new Label("Last Name:");
        lNameTextField = new TextField();
        recNumLabel = new Label("Receipt Num:");
        recNumTextField = new TextField();
        searchButton = new Button("Search");

        searchButton.setOnAction(e -> {
            try {
                GenerateDeliveryList dao = new GenerateDeliveryList();
                String fname = "";
                String lname = "";
                Integer receiptNum = null;
                java.sql.Date date = null;

                if (!fNameTextField.getText().trim().isEmpty()) {
                    fname = fNameTextField.getText();
                }
                if (!lNameTextField.getText().trim().isEmpty()) {
                    lname = lNameTextField.getText();
                }
                if (!recNumTextField.getText().trim().isEmpty()) {
                    receiptNum = Integer.parseInt(recNumTextField.getText());
                }
                if (searchDatePicker.getValue() != null) {
                    date = java.sql.Date.valueOf(searchDatePicker.getValue());
                }

                ObservableList<Delivery> data = FXCollections
                        .observableArrayList(dao.getDeliveries("All Deliveries", date, fname, lname, receiptNum));
                deliveryTable.setItems(data);
                searchStage.close();
            } catch (Exception ex) {
                ex.printStackTrace();
                Alert alert = new Alert(Alert.AlertType.ERROR);
                alert.setHeaderText("Database Error");
                alert.setContentText(ex.getMessage());
                alert.showAndWait();
            }
        });

        GridPane searchGridPane = new GridPane();
        searchGridPane.add(dateLabel, 0, 0);
        searchGridPane.add(searchDatePicker, 1, 0);
        searchGridPane.add(fNameLabel, 0, 1);
        searchGridPane.add(fNameTextField, 1, 1);
        searchGridPane.add(lNameLabel, 0, 2);
        searchGridPane.add(lNameTextField, 1, 2);
        searchGridPane.add(recNumLabel, 0, 3);
        searchGridPane.add(recNumTextField, 1, 3);
        searchGridPane.add(searchButton, 0, 4, 2, 1);
        searchGridPane.setHgap(10);
        searchButton.setAlignment(Pos.CENTER);
        searchGridPane.setPadding(new Insets(10));
        ColumnConstraints col1 = new ColumnConstraints();
        col1.setPrefWidth(150);
        searchGridPane.getColumnConstraints().add(col1);

        HBox titleBox = new HBox(10, searchGridPane);
        titleBox.setAlignment(Pos.CENTER);

        Scene scene = new Scene(titleBox);
        searchStage.setScene(scene);
        searchStage.showAndWait();
    }

    private void refreshTable(TableView<Delivery> deliveryTable, String view) {
        try {
            GenerateDeliveryList dao = new GenerateDeliveryList();
            deliveryTable.setItems(FXCollections.observableArrayList(dao.getDeliveries(view, null, null, null, null)));
            refreshStats();
        } catch (SQLException e) {
            e.printStackTrace();
            Alert alert = new Alert(Alert.AlertType.ERROR);
            alert.setHeaderText("Database Error");
            alert.setContentText(e.getMessage());
            alert.showAndWait();
        }
    }

    private void refreshStats() {
        try {
            GenerateDeliveryList dao = new GenerateDeliveryList();
            todaysDeliveriesLbl.setText("Deliveries for today: " + dao.getTodayCount());
            uncompletedDeliveriesLbl.setText("Uncompleted deliveries: " + dao.getUncompletedCount());
            totalDeliveriesLbl.setText("Total deliveries: " + dao.getTotalCount());
        } catch (SQLException e) {
            e.printStackTrace();
            Alert alert = new Alert(Alert.AlertType.ERROR);
            alert.setHeaderText("Database Error");
            alert.setContentText(e.getMessage());
            alert.showAndWait();
        }
    }

    public void openAddEdit(Stage primaryStage, Delivery d, TableView<Delivery> deliveryTable) {
        Stage addEditStage = new Stage();
        addEditStage.initOwner(primaryStage);
        addEditStage.setTitle("Add Delivery");

        BorderPane root = new BorderPane();
        GridPane leftPane = new GridPane();
        VBox rightPane = new VBox(10);
        HBox topSection = new HBox(20, leftPane, rightPane);
        root.setTop(topSection);

        TextField fnameTf = new TextField();
        TextField lnameTf = new TextField();
        TextField phoneTf = new TextField();
        TextField receiptTf = new TextField();
        TextField createdTf = new TextField();
        TextArea completedByTa = new TextArea();
        TextArea addressTa = new TextArea();
        DatePicker deliveryDate = new DatePicker();

        leftPane.setVgap(5);
        leftPane.setHgap(5);

        completedByTa.setPrefRowCount(2);
        addressTa.setPrefRowCount(3);
        leftPane.add(new Label("First Name"), 0, 0);
        leftPane.add(fnameTf, 0, 1);
        leftPane.add(new Label("Last Name"), 1, 0);
        leftPane.add(lnameTf, 1, 1);
        leftPane.add(new Label("Phone Number"), 0, 2, 2, 1);
        leftPane.add(phoneTf, 0, 3, 2, 1);
        leftPane.add(new Label("Receipt Number"), 0, 4, 2, 1);
        leftPane.add(receiptTf, 0, 5, 2, 1);
        leftPane.add(new Label("Created At"), 0, 6, 2, 1);
        leftPane.add(createdTf, 0, 7, 2, 1);
        leftPane.add(new Label("Completed By"), 0, 8);
        leftPane.add(completedByTa, 0, 9);
        leftPane.add(new Label("Date for Delivery"), 1, 8);
        leftPane.add(deliveryDate, 1, 9);
        leftPane.add(new Label("Address"), 0, 10, 2, 1);
        leftPane.add(addressTa, 0, 11, 2, 1);
        createdTf.setEditable(false);

        completedByTa.prefWidthProperty().bind(leftPane.widthProperty().multiply(0.5));

        Label photoLabel = new Label("Photo of Delivery");
        Pane photoPane = new Pane();
        photoPane.setPrefSize(400, 400);
        photoPane.setStyle("-fx-border-color: black;");

        Button uploadButton = new Button("Upload");
        CheckBox handedCb = new CheckBox("Handed to Customer");
        BorderPane photoControl = new BorderPane();
        photoControl.setLeft(uploadButton);
        photoControl.setRight(handedCb);
        rightPane.getChildren().addAll(photoLabel, photoPane, photoControl);

        Label driverNotesLbl = new Label("Driver Notes");
        TextArea driverNotesTa = new TextArea();
        driverNotesTa.setPrefColumnCount(5);

        Label storeNotesLbl = new Label("Store Notes");
        TextArea storeNotesTa = new TextArea();
        storeNotesTa.setPrefColumnCount(5);

        CheckBox completedCb = new CheckBox("Completed");
        Button submitButton = new Button("Submit");

        BorderPane footer = new BorderPane();
        footer.setLeft(completedCb);
        footer.setRight(submitButton);

        VBox centerContent = new VBox(5, topSection, driverNotesLbl, driverNotesTa, storeNotesLbl, storeNotesTa,
                footer);
        centerContent.setPadding(new Insets(15));
        root.setCenter(centerContent);

        GenerateDeliveryList dao = new GenerateDeliveryList();

        if (d != null) {
            addEditStage.setTitle("Editing Delivery #" + d.getId());
            fnameTf.setText(d.getFname());
            lnameTf.setText(d.getLname());
            phoneTf.setText(d.getPhnum());
            receiptTf.setText(String.valueOf(d.getReceiptNum()));
            addressTa.setText(d.getAddr());
            storeNotesTa.setText(d.getStoreNotes());
            driverNotesTa.setText(d.getDlvNotes());
            String completedBy = d.getCompletedBy();
            if (d.getCompletedDate() != null) {
                completedBy += "\n";
                completedBy += d.getCompletedDate();
            }
            completedByTa.setText(completedBy);
            handedCb.setSelected(d.isHandedToCustomer());
            completedCb.setSelected(d.isCompleted());
            if (d.getDlvDate() != null) {
                deliveryDate.setValue(d.getDlvDate().toLocalDate());
            }
            if (d.getCreatedDate() != null) {
                createdTf.setText(d.getCreatedDate().toString());
            }
            submitButton.setText("Update");
            Button deleteButton = new Button("Delete");
            footer.setCenter(deleteButton);
            deleteButton.setOnAction(e -> {
                Alert confirm = new Alert(Alert.AlertType.CONFIRMATION);
                confirm.setTitle("Confirm Delete");
                confirm.setHeaderText("Delete Delivery #" + d.getId());
                confirm.setContentText("Are you sure you want to delete this delivery?");
                if (confirm.showAndWait().get() == ButtonType.OK) {
                    try {
                        dao.deleteDelivery(d.getId());
                        refreshTable(deliveryTable, currentView);
                        addEditStage.close();
                    } catch (SQLException ex) {
                        ex.printStackTrace();
                        Alert alert = new Alert(Alert.AlertType.ERROR);
                        alert.setHeaderText("Database Error");
                        alert.setContentText(ex.getMessage());
                        alert.showAndWait();
                    }
                }
            });
        }

        submitButton.setOnAction(e -> {
            Date sqlDate = null;
            if (deliveryDate.getValue() != null) {
                sqlDate = java.sql.Date.valueOf(deliveryDate.getValue());
            }
            if (d == null) {
                Delivery newDlv = new Delivery(new Date(System.currentTimeMillis()),
                        sqlDate,
                        fnameTf.getText(),
                        lnameTf.getText(),
                        phoneTf.getText(),
                        addressTa.getText(),
                        storeNotesTa.getText(),
                        driverNotesTa.getText(),
                        Integer.parseInt(receiptTf.getText()),
                        ".",
                        completedCb.isSelected(),
                        completedByTa.getText(),
                        new Date(System.currentTimeMillis()),
                        handedCb.isSelected());
                try {
                    dao.addDelivery(newDlv);
                    refreshTable(deliveryTable, currentView);
                    addEditStage.close();
                } catch (SQLException ex) {
                    ex.printStackTrace();
                    Alert alert = new Alert(Alert.AlertType.ERROR);
                    alert.setHeaderText("Database Error");
                    alert.setContentText(ex.getMessage());
                    alert.showAndWait();
                }
            } else {
                d.setDlvDate(sqlDate);
                d.setFname(fnameTf.getText());
                d.setLname(lnameTf.getText());
                d.setPhnum(phoneTf.getText());
                d.setAddr(addressTa.getText());
                d.setStoreNotes(storeNotesTa.getText());
                d.setDlvNotes(driverNotesTa.getText());
                d.setReceiptNum(Integer.parseInt(receiptTf.getText()));
                d.setCompleted(completedCb.isSelected());
                d.setCompletedBy(completedByTa.getText());
                d.setHandedToCustomer(handedCb.isSelected());
                try {
                    dao.updateDelivery(d);
                    refreshTable(deliveryTable, currentView);
                    addEditStage.close();
                } catch (SQLException ex) {
                    ex.printStackTrace();
                    Alert alert = new Alert(Alert.AlertType.ERROR);
                    alert.setHeaderText("Database Error");
                    alert.setContentText(ex.getMessage());
                    alert.showAndWait();
                }
            }

        });

        Scene scene = new Scene(root);
        addEditStage.setScene(scene);
        addEditStage.showAndWait();

    }

}
