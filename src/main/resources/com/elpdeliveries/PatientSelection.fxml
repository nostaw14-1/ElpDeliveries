<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.elpdeliveries.controller.PatientSelectionController">
   <children>
      <TableView fx:id="patientTable" prefHeight="400.0">
         <columns>
            <TableColumn fx:id="firstNameCol" prefWidth="100.0" text="First Name" />
            <TableColumn fx:id="surnameCol" prefWidth="100.0" text="Surname" />
            <TableColumn fx:id="mobilePhoneCol" prefWidth="100.0" text="Mobile Phone" />
            <TableColumn fx:id="homePhoneCol" prefWidth="100.0" text="Home Phone" />
            <TableColumn fx:id="addressCol" prefWidth="200.0" text="Address" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin>
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUseSelected" text="Use Selected" HBox.hgrow="ALWAYS" />
            <CheckBox fx:id="useMobileCb" contentDisplay="TEXT_ONLY" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" text="Use Mobile Phone" />
         </children>
      </HBox>
   </children>
</VBox>
